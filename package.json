{
  "name": "agentfox",
  "version": "1.1.0",
  "description": "agentfox \u2014 a browser AI agent: drive your real Firefox from a terminal agent, with a white-and-gold chat box inside the page.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "bx": "bin/bx",
    "bx-firefox": "bin/bx-firefox.mjs",
    "bx-watch-firefox": "bin/bx-watch-firefox.mjs",
    "bx-chat-agent": "bin/bx-chat-agent.mjs"
  },
  "files": [
    "bin",
    "bridge",
    "extension",
    "docs"
  ],
  "scripts": {
    "start": "node bridge/server.js",
    "pack": "node bridge/make-xpi.js",
    "setup": "node bin/bx forever && node bridge/make-xpi.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
