{
  "manifest_version": 2,
  "name": "Firefox Bridge (free-pi)",
  "version": "1.0.0",
  "description": "Lets a local free-pi agent read and drive your Firefox tabs over a loopback socket. Private, local-only.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-bridge@free-pi.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "activeTab",
    "<all_urls>",
    "http://127.0.0.1/"
  ],
  "background": {
    "scripts": [
      "page.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Firefox Bridge",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Show/hide the free-pi box in this tab"
    }
  },
  "web_accessible_resources": [
    "chat-frame.html",
    "chat.js",
    "chat.css"
  ]
}
